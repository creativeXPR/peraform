rules_version = '2';

// The suite-wide "suite" database: each person's own things that follow
// them across every Quality Tools app (PeraForm, and later Docs, Sheets…).
// Money lives elsewhere (the "billing" database, functions-only writes);
// everything here is written by people themselves, so it's kept apart.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Keep: saved items to paste later (src/lib/keep.js). Only their owner
    // can see or change them.
    match /keeps/{uid}/items/{id} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['kind', 'app', 'label', 'payload', 'createdAt'])
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 30
        && (request.resource.data.app == null
          || (request.resource.data.app is string && request.resource.data.app.size() <= 30))
        && request.resource.data.label is string && request.resource.data.label.size() <= 200
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 200000
        && request.resource.data.createdAt is timestamp;
    }

    // Anything else: no access until a feature adds its own rule here.
  }
}
