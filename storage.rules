rules_version = '2';

// Rules for PeraForm's own "peraform" bucket only — the project's default
// bucket (and its rules) belongs to Anix. Locked down until uploads
// (#008-C) are designed.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
