rules_version = '2';

// Rules for PeraForm's own bucket (quality-toolsx-peraform) only — other
// Quality Tools apps have their own buckets. Locked down until file-upload
// questions are built.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
