{
  "firestore": [
    {
      "database": "peraform",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": [
    {
      "target": "peraform",
      "rules": "storage.rules"
    }
  ],
  "hosting": {
    "site": "peraform-qt",
    "public": "dist",
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/privacy",
        "destination": "https://quality-toolsx.web.app/privacy",
        "type": 301
      },
      {
        "source": "/terms",
        "destination": "https://quality-toolsx.web.app/terms",
        "type": 301
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8180
    },
    "auth": {
      "port": 9199
    },
    "functions": {
      "port": 5101
    },
    "storage": {
      "port": 9299
    },
    "hub": {
      "port": 4720
    },
    "logging": {
      "port": 4820
    },
    "eventarc": {
      "port": 9399
    },
    "pubsub": {
      "port": 8185
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "peraform",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}