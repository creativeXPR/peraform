{
  "firestore": [
    {
      "database": "peraform",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": [
    {
      "target": "peraform",
      "rules": "storage.rules"
    }
  ],
  "hosting": {
    "site": "peraform-qt",
    "public": "dist",
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/privacy",
        "destination": "https://quality-toolsx.web.app/privacy",
        "type": 301
      },
      {
        "source": "/terms",
        "destination": "https://quality-toolsx.web.app/terms",
        "type": 301
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "peraform",
      "ignore": [
        "node_modules",
        ".git",
        "*.log"
      ]
    }
  ]
}
