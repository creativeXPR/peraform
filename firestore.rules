rules_version = '2';

// Rules for PeraForm's named "peraform" database only — Anix and MulTeam
// have their own databases and rules in the shared c-xpr25 project.
// Document shapes are in src/lib/formModel.js.
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user, including anonymous respondents.
    function isSignedIn() {
      return request.auth != null;
    }

    // Google or email/password — anonymous sessions can't create forms.
    function isRealUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /forms/{formId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }

      function isOwner() {
        return isSignedIn() && request.auth.uid == resource.data.ownerId;
      }

      // Drafts are private; published and closed forms are readable by
      // anyone with the link (closed so respondents see a "closed" notice).
      allow read: if isMember() || resource.data.status in ['published', 'closed'];

      allow create: if isRealUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.status == 'draft';

      // Editors change content; only the owner changes who has access.
      allow update: if isMember()
        && request.resource.data.ownerId == resource.data.ownerId
        && (isOwner() || request.resource.data.memberIds == resource.data.memberIds)
        && request.resource.data.ownerId in request.resource.data.memberIds;

      allow delete: if isOwner();

      // Helpers for the subcollections below (resource there is the child).
      function form() {
        return get(/databases/$(database)/documents/forms/$(formId)).data;
      }

      function isFormMember() {
        return isSignedIn() && request.auth.uid in form().memberIds;
      }

      // Minutes, or 0 when the form isn't a timed quiz.
      function timeLimit() {
        let quiz = form().settings.get('quiz', {});
        return quiz.get('enabled', false) == true ? quiz.get('timeLimit', 0) : 0;
      }

      // Quiz answer key — never readable by respondents.
      match /private/{docId} {
        allow read, write: if isFormMember();
      }

      // Timed quizzes: the server records when each respondent started, once.
      // Respondents can read their own start time (to resume the countdown
      // after a reload) but never change it.
      match /starts/{uid} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isFormMember());
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && form().status == 'published'
          && timeLimit() > 0
          && request.resource.data.keys().hasOnly(['startedAt'])
          && request.resource.data.startedAt == request.time;
        allow delete: if isFormMember();
      }

      match /responses/{responseId} {
        // Respondents can read their own response once its quiz score has
        // been released; members can always read.
        allow read: if isFormMember()
          || (isSignedIn()
            && resource.data.respondentId == request.auth.uid
            && resource.data.get('released', false) == true);

        allow delete: if isFormMember();

        // Members grade: adjust points/score and release results. Answers
        // and everything else stay as submitted.
        allow update: if isFormMember()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['points', 'score', 'released']);

        // Respondents only ever create — never edit or delete.
        // With limitOneResponse the doc id must be the respondent's uid, so
        // a second submission collides with the first and is rejected.
        // Timed quizzes must arrive within the limit (+30s for slow networks)
        // of the server-recorded start.
        allow create: if isSignedIn()
          && form().status == 'published'
          && (!form().settings.requireSignIn || isRealUser())
          && (!form().settings.limitOneResponse || responseId == request.auth.uid)
          && request.resource.data.keys().hasOnly(['respondentId', 'answers', 'submittedAt'])
          && request.resource.data.respondentId == request.auth.uid
          && request.resource.data.submittedAt == request.time
          && request.resource.data.answers is map
          && (timeLimit() == 0 || withinTimeLimit());

        function withinTimeLimit() {
          let start = /databases/$(database)/documents/forms/$(formId)/starts/$(request.auth.uid);
          return exists(start)
            && request.time < get(start).data.startedAt
              + duration.value(timeLimit() * 60 + 30, 's');
        }
      }
    }
  }
}
