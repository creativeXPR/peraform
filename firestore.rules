rules_version = '2';

// Rules for PeraForm's named "peraform" database only — other Quality Tools
// apps have their own databases and rules in the quality-toolsx project.
// Document shapes are in src/lib/formModel.js.
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in user, including anonymous respondents.
    function isSignedIn() {
      return request.auth != null;
    }

    // Google or email/password — anonymous sessions can't create forms.
    function isRealUser() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Makers (people who build forms) need a verified email; people filling
    // in forms don't. Google and email-link accounts are verified already.
    // Same rule as requireVerified() in functions/app.js.
    function isMaker() {
      return isRealUser() && request.auth.token.get('email_verified', false) == true;
    }

    // Each person's own organising: starred forms and folders. Private to
    // them — collaborators organise the same form their own way.
    //   users/{uid}/formMeta/{formId}  { starred, folderId }
    //   users/{uid}/folders/{folderId} { name, createdAt }
    match /users/{uid}/{document=**} {
      allow read, write: if isMaker() && request.auth.uid == uid;
    }

    match /forms/{formId} {
      function isMember() {
        return isMaker() && request.auth.uid in resource.data.memberIds;
      }

      function isOwner() {
        return isMaker() && request.auth.uid == resource.data.ownerId;
      }

      // "Only people you choose": the signed-in, verified account email is on
      // the form's private list (forms/{id}/private/access), by address or by
      // domain. Same check as isAllowedResponder() in functions/access.js.
      function isAllowedResponder() {
        let email = request.auth.token.get('email', '').lower();
        let access = get(/databases/$(database)/documents/forms/$(formId)/private/access).data;
        return isRealUser()
          && request.auth.token.get('email_verified', false) == true
          && email != ''
          && (email in access.get('emails', [])
            || email.split('@')[1] in access.get('domains', []));
      }

      // Drafts are private; published and closed forms are readable by
      // anyone with the link (closed so respondents see a "closed" notice),
      // or, for invited-only forms, by the people on the list.
      allow read: if isMember() || (resource.data.status in ['published', 'closed']
        && (resource.data.get('settings', {}).get('restricted', false) != true
          || isAllowedResponder()));

      allow create: if isMaker()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.status == 'draft';

      // Members may only add or remove themselves from email notifications.
      function notifyChangeIsOwn() {
        let before = resource.data.get('notify', []).toSet();
        let after = request.resource.data.get('notify', []).toSet();
        return after.difference(before).union(before.difference(after))
          .hasOnly([request.auth.uid]);
      }

      // Editors change content; only the owner changes who has access
      // (members and pending invites — usually via the manageCollaborators
      // function, which bypasses these rules).
      allow update: if isMember()
        && request.resource.data.ownerId == resource.data.ownerId
        && (isOwner() || (
          request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.get('invitedEmails', []) == resource.data.get('invitedEmails', [])
        ))
        && request.resource.data.ownerId in request.resource.data.memberIds
        && notifyChangeIsOwn();

      allow delete: if isOwner();

      // Helpers for the subcollections below (resource there is the child).
      function form() {
        return get(/databases/$(database)/documents/forms/$(formId)).data;
      }

      function isFormMember() {
        return isMaker() && request.auth.uid in form().memberIds;
      }

      // Minutes, or 0 when the form isn't a timed quiz.
      function timeLimit() {
        let quiz = form().settings.get('quiz', {});
        return quiz.get('enabled', false) == true ? quiz.get('timeLimit', 0) : 0;
      }

      // Quiz answer key — never readable by respondents.
      match /private/{docId} {
        allow read, write: if isFormMember();
      }

      // Timed quizzes: the server records when each respondent started, once.
      // Respondents can read their own start time (to resume the countdown
      // after a reload) but never change it.
      match /starts/{uid} {
        allow read: if isSignedIn() && (request.auth.uid == uid || isFormMember());
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && form().status == 'published'
          && (form().settings.get('restricted', false) != true
            || isFormMember()
            || isAllowedResponder())
          && timeLimit() > 0
          && request.resource.data.keys().hasOnly(['startedAt'])
          && request.resource.data.startedAt == request.time;
        allow delete: if isFormMember();
      }

      // Answers in progress (useSavedProgress): each respondent's own copy,
      // so a refresh doesn't lose them. Only they can see or change it;
      // it's deleted when they submit.
      match /progress/{uid} {
        allow read, delete: if isSignedIn() && request.auth.uid == uid;
        allow create, update: if isSignedIn()
          && request.auth.uid == uid
          && form().status == 'published'
          && request.resource.data.keys().hasOnly(['answers', 'pageIndex', 'history', 'updatedAt'])
          && request.resource.data.answers is map
          && request.resource.data.answers.size() <= 500
          && request.resource.data.pageIndex is int
          && request.resource.data.history is list
          && request.resource.data.history.size() <= 200
          && request.resource.data.updatedAt == request.time;
      }

      match /responses/{responseId} {
        // Respondents can read their own response once its quiz score has
        // been released; members can always read.
        allow read: if isFormMember()
          || (isSignedIn()
            && resource.data.respondentId == request.auth.uid
            && resource.data.get('released', false) == true);

        allow delete: if isFormMember();

        // Members grade: adjust points/score and release results. Answers
        // and everything else stay as submitted.
        allow update: if isFormMember()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['points', 'score', 'released']);

        // Responses are written only by the submitResponse Cloud Function, which
        // checks App Check, rate limits, cleans answers and enforces the form's
        // settings (published, sign-in, one per person, quiz time limit).
        allow create: if false;
      }
    }
  }
}
