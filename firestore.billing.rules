rules_version = '2';

// The suite-wide "billing" database: credit wallets for every Quality Tools
// app. Only Cloud Functions (Admin SDK) write here; people read their own.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Prices, packs: public (the app shows them and estimates costs).
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /wallets/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // Queries must filter on uid == the caller, or they're refused.
    match /ledger/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /payments/{reference} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    // holds and anything else: functions only.
  }
}
