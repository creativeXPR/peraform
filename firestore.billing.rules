rules_version = '2';

// The suite-wide "billing" database: credit wallets for every Quality Tools
// app. Only Cloud Functions (Admin SDK) write here; people read their own.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Prices, packs: public (the app shows them and estimates costs).
    match /config/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /wallets/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    // Queries must filter on uid == the caller, or they're refused.
    match /ledger/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /payments/{reference} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    // Keep: each person's saved items, shared by every Quality Tools app
    // (src/lib/keep.js). Only they can see or change them.
    match /keeps/{uid}/items/{id} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['kind', 'app', 'label', 'payload', 'createdAt'])
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 30
        && (request.resource.data.app == null
          || (request.resource.data.app is string && request.resource.data.app.size() <= 30))
        && request.resource.data.label is string && request.resource.data.label.size() <= 200
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 200000
        && request.resource.data.createdAt is timestamp;
    }
    // holds and anything else: functions only.
  }
}
