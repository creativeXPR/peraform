# Firebase client config. PeraForm shares the "c-xpr25" Firebase project
# with Anix and MulTeam — register PeraForm as its own Web App inside that
# project (Firebase console > c-xpr25 > Project settings > General > Add
# app) to get its own VITE_FIREBASE_APP_ID. apiKey/authDomain/projectId/
# messagingSenderId are project-level and shared across apps.
#
# VITE_FIREBASE_STORAGE_BUCKET must be PeraForm's own bucket, not the
# project default (Anix's storage rules live on that one).
#
# Copy this file to .env and fill in real values. .env is gitignored; this file is not.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=c-xpr25
VITE_FIREBASE_STORAGE_BUCKET=peraform
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
