# Firebase client config for PeraForm in the "Quality Tools" project
# (quality-toolsx). Find these under Firebase console > Project settings >
# General > Your apps > PeraForm. Not secret, but .env stays out of git.
#
# VITE_FIREBASE_STORAGE_BUCKET is PeraForm's own bucket (quality-toolsx-peraform),
# not the project default — each Quality Tools app gets its own.
#
# Copy this file to .env and fill in real values.
VITE_FIREBASE_API_KEY=
# quality-toolsx.firebaseapp.com works out of the box. To show
# peraform-qt.web.app in the Google sign-in popup instead, add
# https://peraform-qt.web.app/__/auth/handler as a redirect URI on the
# project's OAuth web client first.
VITE_FIREBASE_AUTH_DOMAIN=quality-toolsx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quality-toolsx
VITE_FIREBASE_STORAGE_BUCKET=quality-toolsx-peraform
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (spam protection) — the reCAPTCHA Enterprise *key ID* for
# peraform-qt.web.app. Leave empty to run without App Check.
VITE_RECAPTCHA_SITE_KEY=
# Only for running against the real project from localhost: a debug token
# registered in Firebase console > App Check > Apps > PeraForm > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
